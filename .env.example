# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=fair_play_casino
DB_PORT=3306

# Puerto del servidor
BASE_PORT=3000

# JWT Secrets (CRITICAL: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING_IN_PRODUCTION
JWT_SECRET_ADMIN=CHANGE_THIS_TO_DIFFERENT_RANDOM_32_CHAR_STRING
JWT_EXPIRES=24h

# Environment
NODE_ENV=development

# ============================================
# NOWPAYMENTS CONFIGURATION
# ============================================

# API Credentials
NOWPAYMENTS_API_KEY=8NHV7NR-6E8MXC0-G9PKVS0-MSC1K8H
NOWPAYMENTS_IPN_SECRET=YOUR_IPN_SECRET_KEY_HERE

# API URLs
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_SANDBOX=true

# Conversion Rate
USDT_TO_CHIPS_RATE=10
CHIPS_TO_USDT_RATE=0.1

# Limits (in USDT)
MIN_DEPOSIT_USDT=5
MAX_DEPOSIT_USDT=10000
MIN_WITHDRAWAL_USDT=10
MAX_WITHDRAWAL_USDT=5000

# Payment Settings
PAYMENT_CURRENCY=usdttrc20
PAYMENT_EXPIRATION_MINUTES=15

# Webhook (configure after deployment)
IPN_CALLBACK_URL=http://localhost:3000/api/crypto/webhook/ipn

# KYC Settings
KYC_REQUIRED_FOR_WITHDRAWAL=true
KYC_UPLOAD_PATH=uploads/kyc/
