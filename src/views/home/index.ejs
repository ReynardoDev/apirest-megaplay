<%- include('../layouts/head') %>
    <div class="min-h-full">
        <%- include('../layouts/navbar') %>

            <header
                class="relative bg-gray-800 after:pointer-events-none after:absolute after:inset-x-0 after:inset-y-0 after:border-y after:border-white/10">
                <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
                    <h1 class="text-3xl font-bold tracking-tight text-white">Nuestros Juegos</h1>
                </div>
            </header>

            <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
                <!-- Grid de Juegos -->
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">

                    <!-- Card: Black Diamond -->
                    <div
                        class="group relative overflow-hidden rounded-xl bg-gray-800/50 p-6 transition-all duration-300 hover:bg-gray-800/70 hover:shadow-xl hover:shadow-purple-500/20 border border-white/10 hover:border-purple-500/50">
                        <div class="flex flex-col items-center text-center">
                            <!-- Icono -->
                            <div
                                class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-purple-500 to-pink-500 text-white shadow-lg group-hover:scale-110 transition-transform duration-300">
                                <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                                </svg>
                            </div>

                            <!-- Título -->
                            <h3 class="text-xl font-bold text-white mb-2">Black Diamond</h3>

                            <!-- Descripción -->
                            <p class="text-gray-400 text-sm mb-6">Un slot clásico con grandes multiplicadores.</p>

                            <!-- Botón -->
                            <a href="/api/game/black_diamond"
                                class="w-full rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 px-4 py-2.5 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:from-purple-700 hover:to-pink-700 hover:shadow-lg hover:shadow-purple-500/50">
                                Jugar Ahora
                            </a>
                        </div>
                    </div>

                    <!-- Card: Blackjack Pro -->
                    <div
                        class="group relative overflow-hidden rounded-xl bg-gray-800/50 p-6 transition-all duration-300 hover:bg-gray-800/70 hover:shadow-xl hover:shadow-emerald-500/20 border border-white/10 hover:border-emerald-500/50">
                        <div class="flex flex-col items-center text-center">
                            <!-- Icono -->
                            <div
                                class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-emerald-500 to-teal-500 text-white shadow-lg group-hover:scale-110 transition-transform duration-300">
                                <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
                                    <path
                                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9v-2h2v2zm0-4H9V7h2v5zm4 4h-2v-2h2v2zm0-4h-2V7h2v5z">
                                    </path>
                                </svg>
                            </div>

                            <!-- Título -->
                            <h3 class="text-xl font-bold text-white mb-2">Blackjack Pro</h3>

                            <!-- Descripción -->
                            <p class="text-gray-400 text-sm mb-6">Compite contra la casa en la mesa de Blackjack.</p>

                            <!-- Botón -->
                            <a href="#"
                                class="w-full rounded-lg bg-gradient-to-r from-emerald-600 to-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:from-emerald-700 hover:to-teal-700 hover:shadow-lg hover:shadow-emerald-500/50">
                                Jugar Ahora
                            </a>
                        </div>
                    </div>

                    <!-- Card: Ruleta Europea -->
                    <div
                        class="group relative overflow-hidden rounded-xl bg-gray-800/50 p-6 transition-all duration-300 hover:bg-gray-800/70 hover:shadow-xl hover:shadow-red-500/20 border border-white/10 hover:border-red-500/50">
                        <div class="flex flex-col items-center text-center">
                            <!-- Icono -->
                            <div
                                class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-red-500 to-orange-500 text-white shadow-lg group-hover:scale-110 transition-transform duration-300">
                                <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none">
                                    </circle>
                                    <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
                                </svg>
                            </div>

                            <!-- Título -->
                            <h3 class="text-xl font-bold text-white mb-2">Ruleta Europea</h3>

                            <!-- Descripción -->
                            <p class="text-gray-400 text-sm mb-6">Haz tu apuesta en tu número de la suerte.</p>

                            <!-- Botón -->
                            <a href="#"
                                class="w-full rounded-lg bg-gradient-to-r from-red-600 to-orange-600 px-4 py-2.5 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:from-red-700 hover:to-orange-700 hover:shadow-lg hover:shadow-red-500/50">
                                Jugar Ahora
                            </a>
                        </div>
                    </div>

                </div>
            </div>
    </div>
    </body>

    </html>