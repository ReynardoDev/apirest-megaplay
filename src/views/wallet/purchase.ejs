<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - Fair Play Casino
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes float {

            0%,
            100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        @keyframes shimmer {
            0% {
                background-position: -1000px 0;
            }

            100% {
                background-position: 1000px 0;
            }
        }

        .animate-float {
            animation: float 3s ease-in-out infinite;
        }

        .shimmer {
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            background-size: 1000px 100%;
            animation: shimmer 2s infinite;
        }

        .chip-package {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .chip-package:hover {
            transform: translateY(-8px) scale(1.02);
        }

        .chip-package.selected {
            transform: translateY(-8px) scale(1.05);
        }
    </style>
</head>

<body class="bg-gradient-to-br from-gray-900 via-purple-900 to-gray-900 min-h-screen">
    <%- include('../layouts/navbar', { user: user }) %>

        <div class="container mx-auto px-4 py-8 max-w-7xl">
            <!-- Header -->
            <div class="text-center mb-12">
                <div class="inline-block animate-float mb-4">
                    <div
                        class="w-20 h-20 bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 rounded-full flex items-center justify-center shadow-2xl shadow-amber-500/50">
                        <svg class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 20 20">
                            <path
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" />
                        </svg>
                    </div>
                </div>
                <h1
                    class="text-5xl font-bold text-white mb-3 bg-gradient-to-r from-amber-200 via-yellow-300 to-amber-200 bg-clip-text text-transparent">
                    Comprar Chips
                </h1>
                <p class="text-gray-300 text-lg">Selecciona un paquete o ingresa un monto personalizado</p>
            </div>

            <!-- Alert Messages -->
            <div id="alert-container" class="mb-6"></div>

            <!-- Chip Packages Grid -->
            <div class="mb-12">
                <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
                    <svg class="w-6 h-6 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                        <path
                            d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                    </svg>
                    Paquetes Populares
                </h2>

                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                    <!-- Package: $10 -->
                    <div class="chip-package cursor-pointer bg-gradient-to-br from-gray-800 to-gray-900 border-2 border-gray-700 rounded-xl p-6 text-center hover:border-amber-500 hover:shadow-xl hover:shadow-amber-500/20"
                        onclick="selectPackage(10, this)">
                        <div class="text-4xl mb-2">🪙</div>
                        <div class="text-2xl font-bold text-white mb-1">$10</div>
                        <div class="text-xs text-gray-400">Starter</div>
                    </div>

                    <!-- Package: $25 -->
                    <div class="chip-package cursor-pointer bg-gradient-to-br from-gray-800 to-gray-900 border-2 border-gray-700 rounded-xl p-6 text-center hover:border-blue-500 hover:shadow-xl hover:shadow-blue-500/20"
                        onclick="selectPackage(25, this)">
                        <div class="text-4xl mb-2">💰</div>
                        <div class="text-2xl font-bold text-white mb-1">$25</div>
                        <div class="text-xs text-gray-400">Popular</div>
                    </div>

                    <!-- Package: $50 -->
                    <div class="chip-package cursor-pointer bg-gradient-to-br from-gray-800 to-gray-900 border-2 border-purple-600 rounded-xl p-6 text-center hover:border-purple-400 hover:shadow-xl hover:shadow-purple-500/30 relative overflow-hidden"
                        onclick="selectPackage(50, this)">
                        <div
                            class="absolute top-0 right-0 bg-purple-600 text-white text-xs px-2 py-1 rounded-bl-lg font-bold">
                            HOT</div>
                        <div class="text-4xl mb-2">💎</div>
                        <div class="text-2xl font-bold text-white mb-1">$50</div>
                        <div class="text-xs text-purple-400">Mejor Valor</div>
                    </div>

                    <!-- Package: $100 -->
                    <div class="chip-package cursor-pointer bg-gradient-to-br from-gray-800 to-gray-900 border-2 border-gray-700 rounded-xl p-6 text-center hover:border-green-500 hover:shadow-xl hover:shadow-green-500/20"
                        onclick="selectPackage(100, this)">
                        <div class="text-4xl mb-2">💵</div>
                        <div class="text-2xl font-bold text-white mb-1">$100</div>
                        <div class="text-xs text-gray-400">Pro</div>
                    </div>

                    <!-- Package: $250 -->
                    <div class="chip-package cursor-pointer bg-gradient-to-br from-gray-800 to-gray-900 border-2 border-gray-700 rounded-xl p-6 text-center hover:border-yellow-500 hover:shadow-xl hover:shadow-yellow-500/20"
                        onclick="selectPackage(250, this)">
                        <div class="text-4xl mb-2">👑</div>
                        <div class="text-2xl font-bold text-white mb-1">$250</div>
                        <div class="text-xs text-gray-400">VIP</div>
                    </div>

                    <!-- Package: $500 -->
                    <div class="chip-package cursor-pointer bg-gradient-to-br from-amber-900 to-yellow-900 border-2 border-amber-600 rounded-xl p-6 text-center hover:border-amber-400 hover:shadow-xl hover:shadow-amber-500/30 relative overflow-hidden"
                        onclick="selectPackage(500, this)">
                        <div
                            class="absolute top-0 right-0 bg-gradient-to-r from-amber-500 to-yellow-500 text-gray-900 text-xs px-2 py-1 rounded-bl-lg font-bold">
                            ELITE</div>
                        <div class="text-4xl mb-2">🏆</div>
                        <div class="text-2xl font-bold text-white mb-1">$500</div>
                        <div class="text-xs text-amber-400">High Roller</div>
                    </div>
                </div>
            </div>

            <!-- Purchase Form -->
            <div class="max-w-2xl mx-auto">
                <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700 rounded-2xl p-8 shadow-2xl">
                    <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                        <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z" />
                            <path fill-rule="evenodd"
                                d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z"
                                clip-rule="evenodd" />
                        </svg>
                        Detalles de Compra
                    </h3>

                    <form id="purchase-form" onsubmit="handlePurchase(event)">
                        <!-- Amount Input -->
                        <div class="mb-6">
                            <label for="amount" class="block text-sm font-medium text-gray-300 mb-2">
                                Monto (USD)
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg">$</span>
                                <input type="number" id="amount" name="amount" min="5" max="10000" step="0.01" required
                                    class="w-full pl-10 pr-4 py-3 bg-gray-900 border border-gray-600 rounded-lg text-white text-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all"
                                    placeholder="0.00">
                            </div>
                            <p class="mt-2 text-xs text-gray-400">Mínimo: $5 | Máximo: $10,000</p>
                        </div>

                        <!-- Payment Method -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-300 mb-3">
                                Método de Pago (Simulado)
                            </label>
                            <div class="grid grid-cols-3 gap-3">
                                <label class="cursor-pointer">
                                    <input type="radio" name="payment_method" value="CREDIT_CARD" checked
                                        class="peer sr-only">
                                    <div
                                        class="bg-gray-900 border-2 border-gray-600 peer-checked:border-amber-500 peer-checked:bg-amber-500/10 rounded-lg p-4 text-center transition-all hover:border-gray-500">
                                        <div class="text-2xl mb-1">💳</div>
                                        <div class="text-xs text-gray-300">Tarjeta</div>
                                    </div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="payment_method" value="PAYPAL" class="peer sr-only">
                                    <div
                                        class="bg-gray-900 border-2 border-gray-600 peer-checked:border-blue-500 peer-checked:bg-blue-500/10 rounded-lg p-4 text-center transition-all hover:border-gray-500">
                                        <div class="text-2xl mb-1">🅿️</div>
                                        <div class="text-xs text-gray-300">PayPal</div>
                                    </div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="payment_method" value="CRYPTO" class="peer sr-only">
                                    <div
                                        class="bg-gray-900 border-2 border-gray-600 peer-checked:border-purple-500 peer-checked:bg-purple-500/10 rounded-lg p-4 text-center transition-all hover:border-gray-500">
                                        <div class="text-2xl mb-1">₿</div>
                                        <div class="text-xs text-gray-300">Crypto</div>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Summary -->
                        <div class="bg-gray-900/50 rounded-lg p-4 mb-6 border border-gray-700">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-gray-400">Monto a comprar:</span>
                                <span id="summary-amount" class="text-white font-bold text-lg">$0.00</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-gray-400">Chips a recibir:</span>
                                <span id="summary-chips" class="text-amber-400 font-bold text-lg">0</span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" id="submit-btn"
                            class="w-full bg-gradient-to-r from-amber-500 via-yellow-500 to-amber-500 hover:from-amber-600 hover:via-yellow-600 hover:to-amber-600 text-gray-900 font-bold py-4 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-2xl hover:shadow-amber-500/50 flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z"
                                    clip-rule="evenodd" />
                            </svg>
                            <span id="btn-text">Comprar Chips Ahora</span>
                        </button>
                    </form>
                </div>

                <!-- Security Notice -->
                <div class="mt-6 bg-blue-900/20 border border-blue-700/30 rounded-lg p-4 flex items-start gap-3">
                    <svg class="w-5 h-5 text-blue-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                            d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                            clip-rule="evenodd" />
                    </svg>
                    <div>
                        <p class="text-sm text-blue-300 font-medium">Transacción Segura</p>
                        <p class="text-xs text-blue-400/70 mt-1">Esta es una simulación. No se procesarán pagos reales.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <script>
            let selectedAmount = 0;
            let selectedPackage = null;

            // Select package
            function selectPackage(amount, element) {
                // Remove selection from all packages
                document.querySelectorAll('.chip-package').forEach(pkg => {
                    pkg.classList.remove('selected', 'border-amber-500', 'border-blue-500', 'border-purple-500', 'border-green-500', 'border-yellow-500');
                });

                // Add selection to clicked package
                element.classList.add('selected');
                selectedAmount = amount;
                selectedPackage = element;

                // Update input
                document.getElementById('amount').value = amount;
                updateSummary(amount);
            }

            // Update summary
            function updateSummary(amount) {
                const amountValue = parseFloat(amount) || 0;
                document.getElementById('summary-amount').textContent = `$${amountValue.toFixed(2)}`;
                document.getElementById('summary-chips').textContent = amountValue.toLocaleString();
            }

            // Listen to manual input changes
            document.getElementById('amount').addEventListener('input', function (e) {
                const amount = parseFloat(e.target.value) || 0;
                updateSummary(amount);

                // Deselect package if manual input
                if (selectedPackage) {
                    selectedPackage.classList.remove('selected');
                    selectedPackage = null;
                }
            });

            // Handle purchase
            async function handlePurchase(event) {
                event.preventDefault();

                const amount = parseFloat(document.getElementById('amount').value);
                const paymentMethod = document.querySelector('input[name="payment_method"]:checked').value;
                const submitBtn = document.getElementById('submit-btn');
                const btnText = document.getElementById('btn-text');

                // Validation
                if (!amount || amount < 5) {
                    showAlert('El monto mínimo es $5', 'error');
                    return;
                }

                if (amount > 10000) {
                    showAlert('El monto máximo es $10,000', 'error');
                    return;
                }

                // Disable button
                submitBtn.disabled = true;
                btnText.textContent = 'Procesando...';

                try {
                    const response = await fetch('/api/wallet/purchase', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'include', // 🔑 Envía las cookies (JWT token)
                        body: JSON.stringify({
                            amount: amount,
                            payment_method: paymentMethod
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        showAlert(`¡Compra exitosa! Has recibido $${amount} en chips`, 'success');

                        // Update balance in navbar
                        const balanceElement = document.getElementById('user-balance');
                        if (balanceElement && data.data.new_balance !== undefined) {
                            balanceElement.textContent = data.data.new_balance.toLocaleString();

                            // Animate balance
                            balanceElement.classList.add('animate-pulse');
                            balanceElement.style.color = '#fbbf24'; // Amber
                            setTimeout(() => {
                                balanceElement.style.color = '';
                                balanceElement.classList.remove('animate-pulse');
                            }, 2000);
                        }

                        // Reset form
                        document.getElementById('purchase-form').reset();
                        updateSummary(0);
                        if (selectedPackage) {
                            selectedPackage.classList.remove('selected');
                            selectedPackage = null;
                        }
                    } else {
                        showAlert(data.message || 'Error al procesar la compra', 'error');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showAlert('Error de conexión. Intenta nuevamente.', 'error');
                } finally {
                    submitBtn.disabled = false;
                    btnText.textContent = 'Comprar Chips Ahora';
                }
            }

            // Show alert
            function showAlert(message, type = 'info') {
                const container = document.getElementById('alert-container');
                const alertColors = {
                    success: 'bg-green-900/50 border-green-700 text-green-300',
                    error: 'bg-red-900/50 border-red-700 text-red-300',
                    info: 'bg-blue-900/50 border-blue-700 text-blue-300'
                };

                const alert = document.createElement('div');
                alert.className = `${alertColors[type]} border rounded-lg p-4 mb-4 flex items-center gap-3 animate-pulse`;
                alert.innerHTML = `
                <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <span>${message}</span>
            `;

                container.appendChild(alert);

                // Auto remove after 5 seconds
                setTimeout(() => {
                    alert.remove();
                }, 5000);
            }
        </script>
</body>

</html>