<%- include('../../layouts/head') %>
    <div class="min-h-full bg-gray-900">
        <%- include('../../layouts/navbar') %>

            <header
                class="relative bg-gray-800 after:pointer-events-none after:absolute after:inset-x-0 after:inset-y-0 after:border-y after:border-white/10">
                <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
                    <h1 class="text-3xl font-bold tracking-tight text-white"> Black Diamond </h1>
                </div>
            </header>

            <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
                <div class="flex justify-center">
                    <div class="w-full max-w-2xl">
                        <!-- Game Card -->
                        <div
                            class="relative overflow-hidden rounded-xl bg-gray-800/50 p-8 border border-white/10 shadow-xl">

                            <!-- Game Icon -->
                            <div class="flex justify-center mb-6">
                                <div
                                    class="flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-purple-500 to-pink-500 text-white shadow-lg">
                                    <svg class="h-10 w-10" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                                    </svg>
                                </div>
                            </div>

                            <!-- Bet Amount -->
                            <div class="text-center mb-6">
                                <p class="text-gray-400 text-sm mb-1">Apuesta por giro</p>
                                <p class="text-white text-2xl font-bold">$<span id="betAmount">10</span></p>
                            </div>

                            <!-- Slot Reels -->
                            <div class="flex justify-center gap-6 mb-8">
                                <div id="reel1"
                                    class="reel w-24 h-24 sm:w-28 sm:h-28 bg-white border-4 border-purple-500 rounded-lg flex items-center justify-center text-5xl font-bold text-gray-800 shadow-lg">
                                    7
                                </div>
                                <div id="reel2"
                                    class="reel w-24 h-24 sm:w-28 sm:h-28 bg-white border-4 border-purple-500 rounded-lg flex items-center justify-center text-5xl font-bold text-gray-800 shadow-lg">
                                    7
                                </div>
                                <div id="reel3"
                                    class="reel w-24 h-24 sm:w-28 sm:h-28 bg-white border-4 border-purple-500 rounded-lg flex items-center justify-center text-5xl font-bold text-gray-800 shadow-lg">
                                    7
                                </div>
                            </div>

                            <!-- Result Message -->
                            <div id="resultMessage" class="text-center h-8 mb-6 text-xl font-bold text-white">
                            </div>

                            <!-- Spin Button -->
                            <div class="flex justify-center">
                                <button id="btnSpin"
                                    class="group relative px-12 py-4 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 text-white text-lg font-bold shadow-lg transition-all duration-300 hover:from-purple-700 hover:to-pink-700 hover:shadow-xl hover:shadow-purple-500/50 hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100">
                                    <span class="flex items-center gap-2">
                                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z">
                                            </path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        GIRAR
                                    </span>
                                </button>
                            </div>

                            <!-- Game Info -->
                            <div class="mt-8 pt-6 border-t border-white/10">
                                <div class="grid grid-cols-3 gap-4 text-center">
                                    <div>
                                        <p class="text-gray-400 text-xs mb-1">Apuesta</p>
                                        <p class="text-white font-semibold">$10</p>
                                    </div>
                                    <div>
                                        <p class="text-gray-400 text-xs mb-1">Premio x3</p>
                                        <p class="text-green-400 font-semibold">$100</p>
                                    </div>
                                    <div>
                                        <p class="text-gray-400 text-xs mb-1">Premio x2</p>
                                        <p class="text-yellow-400 font-semibold">$20</p>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- Back Button -->
                        <div class="mt-6 text-center">
                            <a href="/home"
                                class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors duration-200">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                                </svg>
                                Volver a Juegos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
    </div>

    <script>
        // ============================================
        // CONFIGURACIÓN DE SÍMBOLOS
        // ============================================
        const SLOT_SYMBOLS = ["💎", "7️⃣", "⭐", "👑", "🔔", "🍇", "BAR", "🍋", "🍒"];

        // Obtener datos del usuario desde el objeto global (inyectado por el middleware)
        const playerData = {
            id: "<%= user ? user.id : '' %>",
            name: "<%= user ? user.name : '' %>"
        };

        // Verificar que el usuario esté logueado
        if (!playerData.id) {
            window.location.href = '/api/player/form_login';
        }

        const btnSpin = document.getElementById('btnSpin');
        const reel1 = document.getElementById('reel1');
        const reel2 = document.getElementById('reel2');
        const reel3 = document.getElementById('reel3');
        const resultMsg = document.getElementById('resultMessage');

        // ============================================
        // FUNCIONES DE ANIMACIÓN
        // ============================================

        /**
         * Obtiene un símbolo aleatorio de la lista
         */
        function getRandomSymbol() {
            return SLOT_SYMBOLS[Math.floor(Math.random() * SLOT_SYMBOLS.length)];
        }

        /**
         * Aplica animación según el tipo de victoria
         */
        function applyWinAnimation(winType, reels) {
            // Remover clases previas
            [reel1, reel2, reel3].forEach(reel => {
                reel.classList.remove('animate-bounce', 'animate-pulse', 'scale-110', 'border-yellow-400', 'border-green-400', 'border-red-400', 'border-purple-400');
            });

            switch (winType) {
                case 'jackpot':
                    // JACKPOT - Animación épica
                    [reel1, reel2, reel3].forEach(reel => {
                        reel.classList.add('animate-bounce', 'border-yellow-400', 'shadow-2xl');
                        reel.style.borderWidth = '6px';
                    });
                    // Efecto de confetti (simulado con emojis)
                    showConfetti();
                    break;

                case 'bigwin':
                case 'superwin':
                    // BIG WIN / SUPER WIN - Animación fuerte
                    [reel1, reel2, reel3].forEach(reel => {
                        reel.classList.add('animate-pulse', 'border-green-400');
                        reel.style.borderWidth = '5px';
                    });
                    break;

                case 'win':
                    // WIN - Animación media
                    [reel1, reel2, reel3].forEach(reel => {
                        reel.classList.add('border-green-400');
                        reel.style.borderWidth = '4px';
                    });
                    break;

                case 'smallwin':
                    // SMALL WIN - Animación sutil
                    [reel1, reel2, reel3].forEach(reel => {
                        reel.classList.add('border-purple-400');
                    });
                    break;

                default:
                    // Sin premio - borde rojo
                    [reel1, reel2, reel3].forEach(reel => {
                        reel.classList.add('border-red-400');
                    });
            }

            // Restaurar bordes después de 3 segundos
            setTimeout(() => {
                [reel1, reel2, reel3].forEach(reel => {
                    reel.classList.remove('animate-bounce', 'animate-pulse', 'border-yellow-400', 'border-green-400', 'border-red-400', 'border-purple-400');
                    reel.style.borderWidth = '4px';
                    reel.className = 'reel w-24 h-24 sm:w-28 sm:h-28 bg-white border-4 border-purple-500 rounded-lg flex items-center justify-center text-5xl font-bold text-gray-800 shadow-lg transition-all duration-300';
                });
            }, 3000);
        }

        /**
         * Muestra efecto de confetti para jackpot
         */
        function showConfetti() {
            const confettiSymbols = ['🎉', '✨', '💎', '⭐', '🎊'];
            const container = document.querySelector('.max-w-2xl');

            for (let i = 0; i < 20; i++) {
                const confetti = document.createElement('div');
                confetti.innerText = confettiSymbols[Math.floor(Math.random() * confettiSymbols.length)];
                confetti.style.position = 'absolute';
                confetti.style.left = Math.random() * 100 + '%';
                confetti.style.top = '-50px';
                confetti.style.fontSize = '2rem';
                confetti.style.animation = 'fall 3s linear';
                confetti.style.zIndex = '1000';
                container.appendChild(confetti);

                setTimeout(() => confetti.remove(), 3000);
            }
        }

        /**
         * Obtiene el estilo del mensaje según el tipo de victoria
         */
        function getMessageStyle(winType) {
            const baseClass = "text-center h-8 mb-6 text-xl font-bold";

            switch (winType) {
                case 'jackpot':
                    return `${baseClass} text-yellow-400 animate-bounce text-3xl`;
                case 'bigwin':
                case 'superwin':
                    return `${baseClass} text-green-400 animate-pulse text-2xl`;
                case 'win':
                    return `${baseClass} text-green-400`;
                case 'smallwin':
                    return `${baseClass} text-purple-400`;
                default:
                    return `${baseClass} text-red-400`;
            }
        }

        // ============================================
        // EVENTO DE GIRO
        // ============================================
        btnSpin.addEventListener('click', async () => {
            btnSpin.disabled = true;
            resultMsg.innerText = "Girando...";
            resultMsg.className = "text-center h-8 mb-6 text-xl font-bold text-blue-400";

            // Efecto visual de símbolos aleatorios
            const interval = setInterval(() => {
                reel1.innerText = getRandomSymbol();
                reel2.innerText = getRandomSymbol();
                reel3.innerText = getRandomSymbol();
            }, 100);

            try {
                const response = await fetch('/api/spin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include', // 🔑 Importante: Envía las cookies (JWT token)
                    body: JSON.stringify({
                        bet_amount: 10,
                        game_id: 1
                    })
                });

                const data = await response.json();
                clearInterval(interval);

                if (response.ok && data.success) {
                    // Actualizar Reels con un pequeño delay para efecto
                    setTimeout(() => {
                        reel1.innerText = data.reels[0];
                    }, 200);
                    setTimeout(() => {
                        reel2.innerText = data.reels[1];
                    }, 400);
                    setTimeout(() => {
                        reel3.innerText = data.reels[2];
                    }, 600);

                    // Esperar a que se muestren todos los símbolos
                    setTimeout(() => {
                        // Mostrar mensaje del servidor (más descriptivo)
                        resultMsg.innerText = data.message;
                        resultMsg.className = getMessageStyle(data.win_type);

                        // Aplicar animación según tipo de victoria
                        applyWinAnimation(data.win_type, data.reels);

                        // Actualizar el balance en el navbar
                        const balanceElement = document.getElementById('user-balance');
                        if (balanceElement && data.new_balance !== undefined) {
                            // Formatear el balance con separadores de miles
                            balanceElement.innerText = data.new_balance.toLocaleString();

                            // Efecto visual: color según ganancia/pérdida
                            if (data.win_type === 'jackpot') {
                                balanceElement.style.color = "#fbbf24"; // Amarillo dorado
                                balanceElement.classList.add('animate-bounce');
                            } else if (data.win > 0) {
                                balanceElement.style.color = "#10b981"; // Verde
                                balanceElement.classList.add('animate-pulse');
                            } else {
                                balanceElement.style.color = "#ef4444"; // Rojo
                            }

                            // Restaurar color original después de 2 segundos
                            setTimeout(() => {
                                balanceElement.style.color = "";
                                balanceElement.classList.remove('animate-pulse', 'animate-bounce');
                            }, 2000);
                        }
                    }, 800);

                } else {
                    resultMsg.innerText = "Error: " + (data.message || "Fallo");
                    resultMsg.className = "text-center h-8 mb-6 text-xl font-bold text-red-400";
                }

            } catch (error) {
                clearInterval(interval);
                console.error(error);
                resultMsg.innerText = "Error de conexión";
                resultMsg.className = "text-center h-8 mb-6 text-xl font-bold text-red-400";
            } finally {
                btnSpin.disabled = false;
            }
        });

        // ============================================
        // ANIMACIÓN CSS PARA CONFETTI
        // ============================================
        const style = document.createElement('style');
        style.textContent = `
            @keyframes fall {
                to {
                    transform: translateY(100vh) rotate(360deg);
                    opacity: 0;
                }
            }
        `;
        document.head.appendChild(style);
    </script>
    </body>

    </html>