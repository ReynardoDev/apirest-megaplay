<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar Nuevo Jugador - Fair Play Casino</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-gray-900 via-purple-900 to-gray-900 min-h-screen">

    <!-- Navbar -->
    <%- include('../layouts/navbar') %>

        <div class="flex min-h-screen flex-col justify-center px-6 py-12 lg:px-8">

            <!-- Header -->
            <div class="sm:mx-auto sm:w-full sm:max-w-2xl">
                <div class="text-center">
                    <!-- Logo/Icon -->
                    <div
                        class="mx-auto w-20 h-20 bg-gradient-to-br from-purple-500 to-pink-600 rounded-2xl flex items-center justify-center shadow-2xl shadow-purple-500/50 mb-6">
                        <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z">
                            </path>
                        </svg>
                    </div>

                    <h1 class="text-4xl font-bold tracking-tight text-white mb-2">
                        Registrar Nuevo Jugador
                    </h1>
                    <p class="text-gray-400 text-lg">
                        Completa el formulario para crear una nueva cuenta
                    </p>
                </div>
            </div>

            <!-- Form Container -->
            <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-2xl">
                <div
                    class="bg-gray-800/50 backdrop-blur-xl px-8 py-10 shadow-2xl rounded-2xl border border-gray-700/50">

                    <!-- Error Message -->
                    <% if (error) { %>
                        <div class="mb-6 bg-red-500/10 border border-red-500/50 rounded-lg p-4 flex items-start">
                            <svg class="w-6 h-6 text-red-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span class="text-red-400">
                                <%= error %>
                            </span>
                        </div>
                        <% } %>

                            <!-- Success Message -->
                            <% if (message) { %>
                                <div
                                    class="mb-6 bg-green-500/10 border border-green-500/50 rounded-lg p-6 flex flex-col items-center text-center">
                                    <svg class="w-16 h-16 text-green-500 mb-4" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <h3 class="text-xl font-bold text-green-400 mb-2">¡Registro Exitoso!</h3>
                                    <p class="text-green-300 mb-6">
                                        <%= message %>
                                    </p>
                                    <a href="/"
                                        class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold shadow-lg shadow-purple-500/50 hover:shadow-xl hover:shadow-purple-500/70 hover:scale-105 transition-all duration-200">
                                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1">
                                            </path>
                                        </svg>
                                        Ir al Login
                                    </a>
                                </div>
                                <% } %>

                                    <% if (!message) { %>
                                        <!-- Solo mostrar el formulario si NO hay mensaje de éxito -->

                                        <form action="/register" method="POST" class="space-y-6">

                                            <!-- Grid de 2 columnas -->
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                                                <!-- Nombre Completo -->
                                                <div>
                                                    <label for="name"
                                                        class="block text-sm font-medium text-gray-300 mb-2">
                                                        <span class="flex items-center">
                                                            <svg class="w-4 h-4 mr-2 text-purple-400" fill="none"
                                                                stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z">
                                                                </path>
                                                            </svg>
                                                            Nombre Completo
                                                            <span class="text-red-400 ml-1">*</span>
                                                        </span>
                                                    </label>
                                                    <input id="name" type="text" name="name" required
                                                        placeholder="Ej: Juan Pérez García"
                                                        value="<%= item.name || '' %>"
                                                        class="block w-full rounded-lg bg-gray-900/50 border border-gray-600 px-4 py-3 text-white placeholder:text-gray-500 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/50 transition-all duration-200" />
                                                </div>

                                                <!-- Nombre de Usuario -->
                                                <div>
                                                    <label for="username"
                                                        class="block text-sm font-medium text-gray-300 mb-2">
                                                        <span class="flex items-center">
                                                            <svg class="w-4 h-4 mr-2 text-purple-400" fill="none"
                                                                stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z">
                                                                </path>
                                                            </svg>
                                                            Nombre de Usuario
                                                            <span class="text-red-400 ml-1">*</span>
                                                        </span>
                                                    </label>
                                                    <input id="username" type="text" name="username" required
                                                        placeholder="Ej: juanperez" value="<%= item.username || '' %>"
                                                        class="block w-full rounded-lg bg-gray-900/50 border border-gray-600 px-4 py-3 text-white placeholder:text-gray-500 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/50 transition-all duration-200" />
                                                    <p class="mt-1 text-xs text-gray-500">Sin espacios, solo letras y
                                                        números</p>
                                                </div>

                                                <!-- Email -->
                                                <div>
                                                    <label for="email"
                                                        class="block text-sm font-medium text-gray-300 mb-2">
                                                        <span class="flex items-center">
                                                            <svg class="w-4 h-4 mr-2 text-purple-400" fill="none"
                                                                stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                                                                </path>
                                                            </svg>
                                                            Email
                                                            <span class="text-red-400 ml-1">*</span>
                                                        </span>
                                                    </label>
                                                    <input id="email" type="email" name="email" required
                                                        placeholder="Ej: juan@example.com"
                                                        value="<%= item.email || '' %>" autocomplete="email"
                                                        class="block w-full rounded-lg bg-gray-900/50 border border-gray-600 px-4 py-3 text-white placeholder:text-gray-500 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/50 transition-all duration-200" />
                                                </div>

                                                <!-- Contraseña -->
                                                <div>
                                                    <label for="password"
                                                        class="block text-sm font-medium text-gray-300 mb-2">
                                                        <span class="flex items-center">
                                                            <svg class="w-4 h-4 mr-2 text-purple-400" fill="none"
                                                                stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z">
                                                                </path>
                                                            </svg>
                                                            Contraseña
                                                            <span class="text-red-400 ml-1">*</span>
                                                        </span>
                                                    </label>
                                                    <input id="password" type="password" name="password" required
                                                        placeholder="Mínimo 6 caracteres" autocomplete="new-password"
                                                        class="block w-full rounded-lg bg-gray-900/50 border border-gray-600 px-4 py-3 text-white placeholder:text-gray-500 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/50 transition-all duration-200" />
                                                    <p class="mt-1 text-xs text-gray-500">Mínimo 6 caracteres</p>
                                                </div>

                                            </div>

                                            <!-- Información Adicional (Opcional) -->
                                            <div class="border-t border-gray-700 pt-6 mt-6">
                                                <h3 class="text-lg font-semibold text-white mb-4 flex items-center">
                                                    <svg class="w-5 h-5 mr-2 text-purple-400" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                                                        </path>
                                                    </svg>
                                                    Información Adicional (Opcional)
                                                </h3>

                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                                                    <!-- Teléfono -->
                                                    <div>
                                                        <label for="phone"
                                                            class="block text-sm font-medium text-gray-300 mb-2">
                                                            <span class="flex items-center">
                                                                <svg class="w-4 h-4 mr-2 text-gray-400" fill="none"
                                                                    stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z">
                                                                    </path>
                                                                </svg>
                                                                Teléfono
                                                            </span>
                                                        </label>
                                                        <input id="phone" type="tel" name="phone"
                                                            placeholder="Ej: +1234567890"
                                                            value="<%= item.phone || '' %>"
                                                            class="block w-full rounded-lg bg-gray-900/50 border border-gray-600 px-4 py-3 text-white placeholder:text-gray-500 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/50 transition-all duration-200" />
                                                    </div>

                                                    <!-- País -->
                                                    <div>
                                                        <label for="country"
                                                            class="block text-sm font-medium text-gray-300 mb-2">
                                                            <span class="flex items-center">
                                                                <svg class="w-4 h-4 mr-2 text-gray-400" fill="none"
                                                                    stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                                                                    </path>
                                                                </svg>
                                                                País
                                                            </span>
                                                        </label>
                                                        <input id="country" type="text" name="country"
                                                            placeholder="Ej: MX, US, ES" maxlength="2"
                                                            value="<%= item.country || '' %>"
                                                            class="block w-full rounded-lg bg-gray-900/50 border border-gray-600 px-4 py-3 text-white placeholder:text-gray-500 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/50 transition-all duration-200" />
                                                        <p class="mt-1 text-xs text-gray-500">Código ISO de 2 letras</p>
                                                    </div>

                                                </div>
                                            </div>

                                            <!-- Botones -->
                                            <div class="flex gap-4 pt-6">
                                                <button type="submit"
                                                    class="flex-1 group relative px-6 py-3 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold shadow-lg shadow-purple-500/50 hover:shadow-xl hover:shadow-purple-500/70 hover:scale-105 transition-all duration-200 flex items-center justify-center">
                                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                    </svg>
                                                    Crear Jugador
                                                </button>

                                                <a href="/crud"
                                                    class="px-6 py-3 rounded-lg bg-gray-700 text-gray-300 font-semibold hover:bg-gray-600 transition-all duration-200 flex items-center justify-center">
                                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                                                    </svg>
                                                    Cancelar
                                                </a>
                                            </div>

                                        </form>

                                        <!-- Info adicional -->
                                        <div class="mt-8 pt-6 border-t border-gray-700">
                                            <div class="bg-blue-500/10 border border-blue-500/30 rounded-lg p-4">
                                                <div class="flex items-start">
                                                    <svg class="w-5 h-5 text-blue-400 mr-3 flex-shrink-0 mt-0.5"
                                                        fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                                                        </path>
                                                    </svg>
                                                    <div class="text-sm text-blue-300">
                                                        <p class="font-semibold mb-1">Información importante:</p>
                                                        <ul class="list-disc list-inside space-y-1 text-blue-400/80">
                                                            <li>El jugador recibirá <strong>1000 chips de bono</strong>
                                                                al
                                                                registrarse</li>
                                                            <li>La cuenta se creará con estado <strong>ACTIVE</strong>
                                                            </li>
                                                            <li>El email será marcado como <strong>verificado</strong>
                                                            </li>
                                                            <li>La contraseña se encriptará automáticamente</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                                            <!-- Fin del bloque condicional del formulario -->

                </div>

                <!-- Link de regreso -->
                <div class="mt-6 text-center">
                    <a href="/crud"
                        class="text-purple-400 hover:text-purple-300 transition-colors duration-200 flex items-center justify-center">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M11 17l-5-5m0 0l5-5m-5 5h12"></path>
                        </svg>
                        Volver a la lista de jugadores
                    </a>
                </div>
            </div>
        </div>

        <!-- Floating particles effect (optional) -->
        <div class="fixed inset-0 pointer-events-none overflow-hidden">
            <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-purple-500/10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-pink-500/10 rounded-full blur-3xl"></div>
        </div>

</body>

</html>