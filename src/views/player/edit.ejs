<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Player</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>

<body class="h-full">
    <div class="bg-gray-900 min-h-screen">

        <div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
            <div class="sm:mx-auto sm:w-full sm:max-w-sm">
                <h1 class="mt-10 text-center text-2xl/9 font-bold tracking-tight text-white">Edit Player</h1>
            </div>

            <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">

                <form action="/crud/update/<%= item.id_player %>" method="POST" class="space-y-6">

                    <div>
                        <label for="user" class="block text-sm/6 font-medium text-gray-100">User name</label>
                        <div class="mt-2">
                            <input id="user" type="text" name="user" value="<%= item.user %>" required
                                class="block w-full rounded-md bg-gray-800 px-3 py-1.5 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6" />
                        </div>
                    </div>

                    <div>
                        <label for="email" class="block text-sm/6 font-medium text-gray-100">Email address</label>
                        <div class="mt-2">
                            <input id="email" type="email" name="email" value="<%= item.email %>" required
                                autocomplete="email"
                                class="block w-full rounded-md bg-gray-800 px-3 py-1.5 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6" />
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between">
                            <label for="password" class="block text-sm/6 font-medium text-gray-100">Password</label>
                            <span class="text-xs text-gray-400">(Leave blank to keep current)</span>
                        </div>
                        <div class="mt-2">
                            <input id="password" type="password" name="password" autocomplete="new-password"
                                placeholder="New password (optional)"
                                class="block w-full rounded-md bg-gray-800 px-3 py-1.5 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6" />
                        </div>
                    </div>

                    <div>
                        <label for="active" class="block text-sm/6 font-medium text-gray-100">Active</label>
                        <div class="mt-2">
                            <select id="active" name="active" required
                                class="block w-full rounded-md bg-gray-800 px-3 py-1.5 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6">
                                <option value="1" <%=item.active===1 ? 'selected' : '' %>>Active</option>
                                <option value="0" <%=item.active===0 ? 'selected' : '' %>>Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <button type="submit"
                            class="flex w-full justify-center rounded-md bg-indigo-500 px-3 py-1.5 text-sm/6 font-semibold text-white hover:bg-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500">
                            Update
                        </button>
                    </div>
                </form>

                <div class="mt-10 text-center text-sm/6 text-gray-400">
                    back to <a href="/crud" class="text-indigo-500 hover:text-indigo-400">player list</a>
                </div>

                <% if (locals.error) { %>
                    <div class="mt-4 text-center text-red-500 font-bold">
                        <%= error %>
                    </div>
                    <% } %>

            </div>
        </div>
    </div>
</body>

</html>